{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JabeX",
  "version": "0.1.0",
  "identifier": "app.jabex.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../frontend"
    },
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../frontend"
    },
    "frontendDist": "../frontend/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JabeX",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "JabeX Contributors",
    "category": "Education",
    "shortDescription": "Private, offline-first digital Leitner Box",
    "longDescription": "JabeX is a privacy-first flashcard app for Leitner Box study. All decks, cards, and progress stay on your device—no accounts, analytics, or cloud sync required.",
    "copyright": "Copyright © JabeX contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {}
}
