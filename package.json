{
  "name": "jabex",
  "private": true,
  "version": "0.1.4",
  "description": "Private, offline-first digital Leitner Box",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "pnpm --filter @jabex/desktop-frontend dev",
    "build": "pnpm --filter @jabex/desktop-frontend build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "tauri:dev": "pnpm --filter @jabex/desktop tauri:dev",
    "tauri:build": "pnpm --filter @jabex/desktop tauri:build",
    "portable:pack": "node scripts/packaging/pack-portable.mjs",
    "portable:build": "node scripts/packaging/pack-portable.mjs --build",
    "release:assemble": "node scripts/packaging/assemble-release.mjs",
    "db:seed": "node scripts/dev/seed.mjs",
    "db:unseed": "node scripts/dev/unseed.mjs",
    "docs:screenshots": "node scripts/docs/capture-screenshots.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright-core": "^1.64.0"
  }
}
