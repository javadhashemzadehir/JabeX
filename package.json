{
  "name": "jabex",
  "private": true,
  "version": "0.1.0",
  "description": "Private, offline-first digital Leitner Box",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "pnpm --filter @jabex/desktop-frontend dev",
    "build": "pnpm --filter @jabex/desktop-frontend build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "tauri:dev": "pnpm --filter @jabex/desktop tauri:dev",
    "tauri:build": "pnpm --filter @jabex/desktop tauri:build"
  },
  "engines": {
    "node": ">=22"
  }
}
