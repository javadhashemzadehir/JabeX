# Normalize text files to LF in the repository.
* text=auto eol=lf

# Explicit text types
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.svg       text eol=lf
*.rs        text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf
*.env*      text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore  text eol=lf

# Windows scripts keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=lf

# Binary assets — do not normalize
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.icns      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.7z        binary
*.gz        binary
*.tar       binary
*.msi       binary
*.dmg       binary
*.AppImage  binary
*.exe       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.db        binary
*.sqlite    binary
*.sqlite3   binary

# Lockfiles — treat as text but discourage noisy diffs in tools that respect this
pnpm-lock.yaml  text eol=lf linguist-generated=true
Cargo.lock      text eol=lf linguist-generated=true
